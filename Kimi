/* 龙虾自己的黑眼（触角顶端，带右上角白色矩形高光）+ Kimi 的白眼（面罩上）
   两对眼睛的坐标、尺寸全部由原图逐像素量取：
     黑眼 左(-0.128,-0.281) r0.045/0.087 ／ 右(0.083,-0.292) r0.042/0.083
     白眼 左(-0.038,0.174)  r0.052/0.090 ／ 右(0.222,0.156) r0.049/0.087
   白眼两眼取同尺寸、同一水平线（y=0.165）。 */
const CRAB_EYES=[[-0.128,-0.281,0.045,0.087],[0.083,-0.292,0.042,0.083]];
const CRAB_KIMI=[[-0.038,0.165,0.0505,0.0885],[0.222,0.165,0.0505,0.0885]];

/* 龙虾不再画自己那对黑眼 —— 眼睛由 Kimi 的白色胶囊眼叠上去，避免两层眼睛打架 */



/* 竖向胶囊（矩形 + 两端圆），跟 Kimi 原版同形状；两端用多边形近似圆弧 → 边有棱角 */
function capsulePath(rx,ry,seg){
  const w=rx, h=ry, r=Math.min(w,h);
  const pts=[];
  const corner=(cx,cy,a0,a1)=>{
    for(let i=0;i<=seg;i++){
      const t=a0+(a1-a0)*(i/seg);
      pts.push([cx+r*Math.cos(t), cy+r*Math.sin(t)]);
    }
  };
  corner(-w+r,-h+r, Math.PI,        Math.PI*1.5);   // 左上
  corner( w-r,-h+r, Math.PI*1.5,    Math.PI*2  );   // 右上
  corner( w-r, h-r, 0,              Math.PI*0.5);   // 右下
  corner(-w+r, h-r, Math.PI*0.5,    Math.PI    );   // 左下
  const q=new Path2D();
  q.moveTo(pts[0][0],pts[0][1]);
  for(let i=1;i<pts.length;i++) q.lineTo(pts[i][0],pts[i][1]);
  q.closePath();
  return q;
}

function drawCrab(now){
  updateSharedRot(gaze.x, gaze.y);   // 两眼共用倾角，与原版一致
  // 整体缩放 = 呼吸 × 点击弹簧（press 负=放大、正=缩小）
  const sc=(1+crabBreath)*(1-press);
  const R=CFG.bodySize/2*S*CFG.crabScale*sc;
  const P=crabPal();
  const r=(now<rageUntil&&rage>0.01)?rage:0;
  const shake=r?Math.sin(now/58)*r*0.018:0;
  const lid=eyes.l.lid;

  ctx.save();
  ctx.translate(cx0+shake, cy0);
  ctx.scale(R,R);

  /* 1. 龙虾本体：纯矢量多边形大色块，按面积从大到小铺，每层都完整覆盖自己的区域。
        层与层不会留缝，因为底层就是整只轮廓的实色，上面几层只是叠色块。
        全部硬边纯色、无渐变、无阴影 —— 和原图的扁平平涂一致。 */
  const bp0=new Path2D(); addPoly(bp0, CRAB_SIL);
  ctx.lineJoin='round';
  ctx.fillStyle=P.b2; ctx.fill(bp0);                       // 红中档：铺满整只（底）
  ctx.strokeStyle=P.b2; ctx.lineWidth=0.004; ctx.stroke(bp0);
  ctx.save(); ctx.clip(bp0);
  ctx.fillStyle=P.b3; ctx.strokeStyle=P.b3; ctx.lineWidth=0.004;
  for(const poly of CRAB_DRK){ const q=new Path2D(); addPoly(q,poly); ctx.fill(q); ctx.stroke(q); }
  ctx.fillStyle=P.b1; ctx.strokeStyle=P.b1; ctx.lineWidth=0.004;
  for(const poly of CRAB_LIT){ const q=new Path2D(); addPoly(q,poly); ctx.fill(q); ctx.stroke(q); }
  ctx.restore();

  /* 2. 蓝色面罩：暗档打底 → 亮块叠上（原图蓝面罩 暗35% / 亮65%） */
  const mp=new Path2D(); addPoly(mp, CRAB_MASK);
  ctx.fillStyle=P.m2; ctx.fill(mp);
  ctx.strokeStyle=P.m2; ctx.lineWidth=0.004; ctx.stroke(mp);
  ctx.save(); ctx.clip(mp);
  ctx.fillStyle=P.m1; ctx.strokeStyle=P.m1; ctx.lineWidth=0.004;
  for(const poly of CRAB_MBRK){ const q=new Path2D(); addPoly(q,poly); ctx.fill(q); ctx.stroke(q); }
  ctx.restore();

  /* 3. 龙虾自己的黑眼：触角顶端的竖向胶囊，右上角一小块白色矩形高光，
        被眼形裁掉后看着像「露出的一角」。静态，不眨眼。 */
  for(const [ex,ey,erx,ery] of CRAB_EYES){
    ctx.save(); ctx.translate(ex,ey);
    const ep=capsulePath(erx, ery, 5);
    ctx.fillStyle=P.eye; ctx.fill(ep);
    ctx.save(); ctx.clip(ep);
    ctx.fillStyle=P.eyeHi;
    ctx.fillRect(erx*0.55-erx*0.45, -ery*0.60-ery*0.365, erx*0.90, ery*0.73);
    ctx.restore(); ctx.restore();
  }

  /* 4. Kimi 的眼睛：面罩上的两个白色竖向胶囊
        形状、眨眼、生气斜切 —— 走和原版小球同一个 kimiEyeShape() */
  const gx=gaze.x*0.042, gy=gaze.y*0.026;
  ctx.save();
  ctx.clip(mp);
  for(let i=0;i<CRAB_KIMI.length;i++){
    const [ex,ey,erx,ery]=CRAB_KIMI[i];
    const sd=i?'r':'l';
    const [ya,yb]=lidCut(ery,ery*2,lid,sd,CFG.crabLidSlant);  // 蟹眼短 → 斜切放轻
    ctx.save();
    ctx.translate(ex+gx, ey+gy);   // 龙虾：只跟着视角平移，不歪斜
    kimiEyeShape(erx, ery, ya, yb);
    ctx.restore();
  }
  ctx.restore();

  ctx.restore();
}

/* 圆角长方形对话框：居中显示，文字打字机效果逐字出现 */
function roundRect(x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.lineTo(x+w-r,y); ctx.quadraticCurveTo(x+w,y,x+w,y+r);
  ctx.lineTo(x+w,y+h-r); ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);
  ctx.lineTo(x+r,y+h); ctx.quadraticCurveTo(x,y+h,x,y+h-r);
  ctx.lineTo(x,y+r); ctx.quadraticCurveTo(x,y,x+r,y);
  ctx.closePath();
}

function bubbleBox(now){
  const fs=Math.max(16, Math.round(Math.min(W,H)*0.042));
  const txt=curLines()[bubbleIdx]||'';
  ctx.font='500 '+fs+'px -apple-system,BlinkMacSystemFont,"PingFang SC",system-ui,sans-serif';
  const tw=ctx.measureText(txt).width;
  const w=clamp(tw+fs*2.2, Math.min(W*0.46, W-28), W*0.90), h=fs*3.1;
  const r=Math.min(h*0.42, fs*1.0);
  return {x:clamp(W*CFG.bubbleX-w/2, 12, W-w-12),
          y:clamp(H*CFG.bubbleY-h/2, 12, H-h-12), w, h, r, fs, txt};
}

function drawBubble(now){
  if(!bubbleShown || bubbleIdx<0) return;
  const B=bubbleBox(now);
  const age=now-bubbleT0;
  // 淡入
  const a=clamp(age/240, 0, 1);

  ctx.save();
  ctx.globalAlpha=a;
  ctx.shadowColor=TH().cardShadow;
  ctx.shadowOffsetY=Math.max(2,B.h*0.10);
  ctx.shadowBlur=B.h*0.55;
  ctx.fillStyle=TH().card;
  roundRect(B.x,B.y,B.w,B.h,B.r); ctx.fill();
  ctx.shadowBlur=0; ctx.shadowOffsetY=0;
  ctx.strokeStyle=TH().cardBorder;
  ctx.lineWidth=1;
  roundRect(B.x,B.y,B.w,B.h,B.r); ctx.stroke();

  // 打字机：按字数逐字吐出
  ctx.font='500 '+B.fs+'px -apple-system,BlinkMacSystemFont,"PingFang SC",system-ui,sans-serif';
  ctx.textAlign='left'; ctx.textBaseline='middle';
  ctx.fillStyle='#33415c';
  const shown=clamp(Math.floor(age/CFG.typeMs), 0, B.txt.length);
  const part=B.txt.slice(0,shown);
  const pw=ctx.measureText(part).width;
  ctx.fillText(part, B.x+(B.w-pw)/2, B.y+B.h/2);   // 已出现的部分保持居中

  // 光标：打完前闪烁
  if(shown<B.txt.length && Math.floor(age/380)%2===0){
    ctx.fillStyle=TH().fg;
    ctx.fillRect(B.x+(B.w-pw)/2+pw+1, B.y+B.h/2-B.fs*0.42, Math.max(1,B.fs*0.08), B.fs*0.84);
  }
  ctx.restore();
}

/* 竖向胶囊：中间矩形 + 两端半圆，以 (0,0) 为中心、逻辑单位
   白色不是贴在球面上的，而是被外面那层深蓝包裹着、从里面透出来的光。
   所以：本体是中心纯白、边缘转蓝白的渐变，外圈再散一圈蓝白辉光。 */
function capsule(rx,ry){
  const r=Math.min(rx,ry)*CFG.eyeRound;   // 圆角：越小越接近圆角矩形（更钝）
  const flat=Math.max(0, ry-r);           // 直边半长
  ctx.beginPath();
  ctx.arc(0, -flat, r, Math.PI, 0);       // 上端半圆
  ctx.lineTo(rx, flat);                   // 右侧直边
  ctx.arc(0, flat, r, 0, Math.PI);        // 下端半圆
  ctx.closePath();

  ctx.fillStyle='#ffffff';   // 纯白，不掺蓝
  ctx.fill();
}


/* ---------------- 设置界面 ---------------- */
const gear=document.getElementById('gear'), panel=document.getElementById('panel');
const swWrap=document.getElementById('swatches'), themeSeg=document.getElementById('themeSeg');
const backBtn=document.getElementById('backBtn');

const LS={
  get(k,d){ try{ const v=localStorage.getItem('kimi_'+k); return v===null?d:v; }catch(e){ return d; } },
  set(k,v){ try{ localStorage.setItem('kimi_'+k,v); }catch(e){} }
};

HUES.forEach(o=>{
  const b=document.createElement('button');
  b.className='sw'; b.dataset.hue=o.id; b.title=o.name; b.setAttribute('aria-label',o.name);
  const i=document.createElement('i');
  i.style.background='linear-gradient(135deg,'+hsl(o.h,66,68)+','+hsl(o.h,62,52)+')';
  b.appendChild(i);
  b.addEventListener('click',()=>setHue(o.id));
  swWrap.appendChild(b);
});
function setHue(id,fromSlider){
  hueId=id; LS.set('hue',id);
  const o=HUES.find(x=>x.id===id)||HUES[0];
  fixedSkin=o.fx||null;                // 第一个预设 → 原版色值；其余由 HSL 生成
  LS.set('fix', fixedSkin?'1':'0');    // 记住「用的是原版色」，刷新后才不会被 HSL 覆盖
  skinFromHue(o.h);
  [...swWrap.children].forEach(b=>b.classList.toggle('on', b.dataset.hue===id));
  if(!fromSlider){
    // 点预设：只换色相，保留自己调的饱和度/明度
    PK.h=o.h; applyPicker(true);
    [...swWrap.children].forEach(b=>b.classList.toggle('on', b.dataset.hue===id));
  }
}
function setTheme(t){
  theme=t; LS.set('theme',t);
  document.documentElement.setAttribute('data-theme',t);
  [...themeSeg.children].forEach(b=>b.classList.toggle('on', b.dataset.theme===t));
}
[...themeSeg.children].forEach(b=>b.addEventListener('click',()=>setTheme(b.dataset.theme)));

function openPanel(){
  panel.classList.add('open'); gear.style.transform='rotate(90deg)';
}
function closePanel(){ panel.classList.remove('open'); gear.style.transform=''; }
gear.addEventListener('pointerdown',e=>e.stopPropagation());
gear.addEventListener('click',openPanel);
backBtn.addEventListener('click',closePanel);
panel.addEventListener('click',e=>{ if(e.target===panel) closePanel(); });
window.addEventListener('keydown',e=>{ if(e.key==='Escape') closePanel(); });

/* ---------------- 自定义颜色：三条滑块（色相 / 饱和度 / 明度） ---------------- */
const hueR=document.getElementById('hueR'),  hueV=document.getElementById('hueV');
const satR=document.getElementById('satR'),  satV=document.getElementById('satV');
const litR=document.getElementById('litR'),  litV=document.getElementById('litV');
const pickHex=document.getElementById('pickHex');
const resetC=document.getElementById('resetC');

const PK={h:215,s:65,l:57};

function syncSliders(){
  hueR.value=PK.h; satR.value=PK.s; litR.value=PK.l;
  hueV.textContent=PK.h; satV.textContent=PK.s; litV.textContent=PK.l;
  // 饱和度条：当前色相下 低饱和 → 高饱和
  satR.style.setProperty('--satTrack',
    'linear-gradient(90deg,'+hsl(PK.h,0,PK.l)+','+hsl(PK.h,100,PK.l)+')');
  // 明度条：当前色相饱和度下 暗 → 亮
  litR.style.setProperty('--litTrack',
    'linear-gradient(90deg,'+hsl(PK.h,PK.s,22)+','+hsl(PK.h,PK.s,86)+')');
}

function applyPicker(keepFixed){
  hueH=PK.h; hueS=PK.s; hueL=PK.l;
  if(!keepFixed){ fixedSkin=null; LS.set('fix','0'); }   // 手动调 → 交回 HSL
  skinFromHue(PK.h,PK.s,PK.l);
  if(fixedSkin) Object.assign(SKIN, fixedSkin);
  pickHex.textContent=fixedSkin?fixedSkin.core:hsl2hex(PK.h,PK.s,PK.l);
  LS.set('hsl', PK.h+','+PK.s+','+PK.l);
  if(!fixedSkin) [...swWrap.children].forEach(b=>b.classList.remove('on'));
  syncSliders();
}

/* 样式切换：原版 / 龙虾 */
const styleSeg=document.getElementById('styleSeg');
function setStyle(t){
  styleMode=t; LS.set('style',t);
  [...styleSeg.children].forEach(b=>b.classList.toggle('on', b.dataset.style===t));
  // 清掉飞行/放大/甩爪的残留状态，切换后干净起步
  FL.flying=false; FL.x=0; FL.y=0; FL.vx=0; FL.vy=0; FL.homeT=-99999; FL.t0=-99999;
  TRAIL.length=0; RINGS.length=0;
  press=0; pressV=0; popUntil=-99999; sq=0; sqV=0;
}
[...styleSeg.children].forEach(b=>b.addEventListener('click',()=>setStyle(b.dataset.style)));

const onRange=(el,fn)=>{ el.addEventListener('input',()=>fn(+el.value)); };
onRange(hueR,v=>{ PK.h=v; applyPicker(false); });
onRange(satR,v=>{ PK.s=v; applyPicker(false); });
onRange(litR,v=>{ PK.l=v; applyPicker(false); });

resetC.addEventListener('click',()=>{
  setHue('blue');                    // 走预设 → 拿到写死的原版色值
  PK.h=215; PK.s=65; PK.l=57;
  applyPicker(true);
});

const savedHSL=(LS.get('hsl','')||'').split(',');

// fix 标记要在 setHue() 之前读：setHue 自己也会写它，会覆盖掉上次的记录
const isFixed = LS.get('fix','1')==='1';
setStyle(LS.get('style','ball')==='crab'?'crab':'ball');
setHue(HUES.some(x=>x.id===LS.get('hue','blue')) ? LS.get('hue','blue') : 'blue');
setTheme(LS.get('theme','light')==='dark'?'dark':'light');
// 恢复自定义值：若上次停在「原版默认色」，就不要用 HSL 覆盖它
if(!isFixed && savedHSL.length===3 && !isNaN(+savedHSL[0])){
  PK.h=+savedHSL[0]; PK.s=+savedHSL[1]; PK.l=+savedHSL[2];
  applyPicker(false);
}else{
  applyPicker(true);                   // 保持原版色 / 同步滑块显示
}

/* ---------------- 主循环 ---------------- */
let prev=0;
function frame(now){
  const dt=prev?now-prev:16;
  prev=now;
  step(now,dt);
  draw(now);
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);
})();
</script>
